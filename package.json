{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Small URL shortener for manual EC2, nginx, and systemd practice.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "npm run build && node dist/src/server.js",
    "start:env": "npm run build && node --env-file=.env dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "devops",
    "ec2",
    "nginx",
    "systemd"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
